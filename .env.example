# Casewise environment variables — copy to .env and fill in. Never commit .env.

# --- LLM (required for RAG) ---
# https://console.anthropic.com → API keys (use an org with zero-retention terms)
# Prefer a workspace-scoped key; an org-scoped key also needs the workspace id
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=

# --- Embeddings (required for RAG) ---
# https://www.voyageai.com → API keys (benchmark voyage-law model vs general)
VOYAGE_API_KEY=

# --- Data sources ---
# Free key: https://legislation.nysenate.gov (sign up → API key by email)
NYSENATE_API_KEY=
# Free account token: https://www.courtlistener.com → profile → API token
COURTLISTENER_API_TOKEN=

# --- Database (Supabase project → Settings → API / Database) ---
# project URL is https://<ref>.supabase.co; anon key: Settings → API → anon/public
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Cloudflare R2 (bulk data hosting: citation catalog, NY archive) ---
# R2 → Manage API tokens → Object Read & Write scoped to casewise-data
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# --- Observability (optional at first) ---
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
